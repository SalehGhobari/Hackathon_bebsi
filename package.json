{
  "name": "fahes",
  "version": "0.1.0",
  "private": true,
  "productName": "Fahes",
  "description": "Fahes - a local-first recycle & replace app: scan hardware, stash e-waste, generate recycling manifests, find compatible parts.",
  "license": "MIT",
  "author": "Fahes",
  "main": "dist/electron/main.js",
  "scripts": {
    "build:main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist/electron",
    "dev": "npm run build:main && electron .",
    "start": "npm run dev",
    "test:scan": "esbuild test/scan.ts --bundle --platform=node --format=cjs --outfile=dist/test-scan.cjs && node dist/test-scan.cjs",
    "test:market": "esbuild test/market.ts --bundle --platform=node --format=cjs --outfile=dist/test-market.cjs && node dist/test-market.cjs",
    "test:classify": "esbuild test/classify.ts --bundle --platform=node --format=cjs --outfile=dist/test-classify.cjs && node dist/test-classify.cjs",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && npm run build:main",
    "pack:linux": "npm run build:main && electron-builder --linux AppImage",
    "pack:win": "npm run build:main && electron-builder --win nsis",
    "pack:dir": "npm run build:main && electron-builder --dir",
    "test:stash": "esbuild test/stash.ts --bundle --platform=node --format=cjs --outfile=dist/test-stash.cjs && node dist/test-stash.cjs",
    "test:deepseek": "esbuild test/deepseek.ts --bundle --platform=node --format=cjs --outfile=dist/test-deepseek.cjs && node dist/test-deepseek.cjs",
    "test:retail": "esbuild test/retail.ts --bundle --platform=node --format=cjs --outfile=dist/test-retail.cjs && node dist/test-retail.cjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.24.2": true
  }
}
